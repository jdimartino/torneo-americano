{
  "hosting": {
    "target": "torneo-americano-jdm-2",
    "public": "public",
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "Pragma", "value": "no-cache" },
          { "key": "Expires", "value": "0" }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/admin.html", "destination": "/admin.html" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
