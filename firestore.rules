rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /config/{docId} {
      allow read, write: if true;
    }

    match /torneosAmericano/{tournamentId} {
      allow read, write: if true;

      match /{subcollection}/{document=**} {
        allow read, write: if true;
      }
    }

    match /jugadores/{jugadorId} {
      allow read, write: if true;
    }

    match /partidos_eliminatoria/{partidoId} {
      allow read, write: if true;
    }

    match /cuartos/{cuartoId} {
      allow read, write: if true;
    }

    match /semifinales/{semiId} {
      allow read, write: if true;
    }

    match /final/{finalId} {
      allow read, write: if true;
    }
  }
}
